40ff\nborder_width = 2\ncorner_radius = 15\n","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":1,"endColumn":1}}]},{"type":"create","uri":{"$mid":1,"fsPath":"/home/shiham/.config/snappy-switcher/themes/dracula.ini","external":"file:///home/shiham/.config/snappy-switcher/themes/dracula.ini","path":"/home/shiham/.config/snappy-switcher/themes/dracula.ini","scheme":"file"},"requestId":"request_c15de3ee-019b-435c-b5e7-a7e2dd2589ce","epoch":13,"initialContent":"","telemetryInfo":{}},{"type":"textEdit","uri":{"$mid":1,"fsPath":"/home/shiham/.config/snappy-switcher/themes/dracula.ini","external":"file:///home/shiham/.config/snappy-switcher/themes/dracula.ini","path":"/home/shiham/.config/snappy-switcher/themes/dracula.ini","scheme":"file"},"requestId":"request_c15de3ee-019b-435c-b5e7-a7e2dd2589ce","epoch":14,"edits":[{"text":"[colors]\nbackground = #282a36ff\ncard_bg = #44475aff\ncard_selected = #6272a4ff\ncard_hover = #565c75ff\ntext_color = #f8f8f2ff\nsubtext_color = #f1fa8cff\nborder_color = #50fa7bff\nbundle_bg = #565c75ff\nbadge_bg = #50fa7bff\nbadge_text_color = #282a36ff\nborder_width = 2\ncorner_radius = 15\n","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":1,"endColumn":1}}]},{"type":"create","uri":{"$mid":1,"fsPath":"/home/shiham/.local/bin/snappy-theme-sync","external":"file:///home/shiham/.local/bin/snappy-theme-sync","path":"/home/shiham/.local/bin/snappy-theme-sync","scheme":"file"},"requestId":"request_c15de3ee-019b-435c-b5e7-a7e2dd2589ce","epoch":15,"initialContent":"","telemetryInfo":{}},{"type":"textEdit","uri":{"$mid":1,"fsPath":"/home/shiham/.local/bin/snappy-theme-sync","external":"file:///home/shiham/.local/bin/snappy-theme-sync","path":"/home/shiham/.local/bin/snappy-theme-sync","scheme":"file"},"requestId":"request_c15de3ee-019b-435c-b5e7-a7e2dd2589ce","epoch":16,"edits":[{"text":"#!/bin/bash\n# ~/.local/bin/snappy-theme-sync\n# Syncs Snappy Switcher theme with Hyprland/system theme changes\n\nCONFIG_FILE=\"$HOME/.config/snappy-switcher/config.ini\"\nTHEME_DIR=\"$HOME/.config/snappy-switcher/themes\"\nCOLOR_CSS=\"$HOME/.config/colors.css\"  # Adjust to your custom theme file\nWATCH_DIR=\"$HOME/.config\"\n\n# Theme mapping: matches your color scheme file to Snappy theme\ndeclare -A THEME_MAP=(\n    [\"catppuccin-mocha\"]=\"catppuccin-mocha-dark.ini\"\n    [\"catppuccin-latte\"]=\"catppuccin-latte-light.ini\"\n    [\"gruvbox\"]=\"gruvbox-dark.ini\"\n    [\"nord\"]=\"nord.ini\"\n    [\"dracula\"]=\"dracula.ini\"\n)\n\n# Function to extract theme name from color.css or config\nget_current_theme() {\n    # Option 1: Check a theme file/symlink\n    if [ -L \"$COLOR_CSS\" ]; then\n        local theme_name=$(basename \"$(readlink \"$COLOR_CSS\")\" .css)\n        echo \"$theme_name\"\n    # Option 2: Parse from waybar config or custom file\n    elif [ -f \"$HOME/.config/waybar/config\" ]; then\n        grep -o '\"theme\"[[:space:]]*:[[:space:]]*\"[^\"]*' \"$HOME/.config/waybar/config\" | cut -d'\"' -f4\n    else\n        echo \"catppuccin-mocha\"  # fallback\n    fi\n}\n\n# Function to update Snappy Switcher theme\nupdate_snappy_theme() {\n    local current_theme=$(get_current_theme)\n    local snappy_theme=\"${THEME_MAP[$current_theme]:-catppuccin-mocha-dark.ini}\"\n    \n    # Update config.ini\n    if grep -q \"^name = \" \"$CONFIG_FILE\"; then\n        sed -i \"s/^name = .*/name = $snappy_theme/\" \"$CONFIG_FILE\"\n        echo \"✓ Updated Snappy Switcher to: $snappy_theme\"\n        \n        # Restart snappy-switcher daemon\n        pkill -f snappy-switcher\n        sleep 0.5\n        snappy-switcher --daemon &\n    fi\n}\n\n# Watch for changes\nif command -v inotifywait &> /dev/null; then\n    echo \"Watching for theme changes...\"\n    inotifywait -m -e modify,create \"$WATCH_DIR\" |\n    while read -r directory action filename; do\n        # Trigger on color.css or relevant config files\n        if [[ \"$filename\" =~ (color\\.css|waybar|theme) ]]; then\n            sleep 0.5  # debounce\n            update_snappy_theme\n        fi\n    done\nelse\n    # Fallback: poll every 5 seconds\n    echo \"inotify not available, using polling...\"\n    while true; do\n        update_snappy_theme\n        sleep 5\n    done\nfi\n","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":1,"endColumn":1}}]},{"type":"create","uri":{"$mid":1,"fsPath":"/home/shiham/.config/systemd/user/snappy-theme-sync.service","external":"file:///home/shiham/.config/systemd/user/snappy-theme-sync.service","path":"/home/shiham/.config/systemd/user/snappy-theme-sync.service","scheme":"file"},"requestId":"request_c15de3ee-019b-435c-b5e7-a7e2dd2589ce","epoch":17,"initialContent":"","telemetryInfo":{}},{"type":"textEdit","uri":{"$mid":1,"fsPath":"/home/shiham/.config/systemd/user/snappy-theme-sync.service","external":"file:///home/shiham/.config/systemd/user/snappy-theme-sync.service","path":"/home/shiham/.config/systemd/user/snappy-theme-sync.service","scheme":"file"},"requestId":"request_c15de3ee-019b-435c-b5e7-a7e2dd2589ce","epoch":18,"edits":[{"text":"[Unit]\nDescription=Snappy Switcher Theme Sync\nAfter=graphical-session-pre.target\nPartOf=graphical-session.target\n\n[Service]\nType=simple\nExecStart=%h/.local/bin/snappy-theme-sync\nRestart=on-failure\nRestartSec=5\n\n[Install]\nWantedBy=graphical-session.target\n","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":1,"endColumn":1}}]}],"epochCounter":19},"recentSnapshot":{"entries":[{"resource":"file:///home/shiham/.config/snappy-switcher/themes/catppuccin-mocha-dark.ini","languageId":"ini","originalHash":"6ac3d12","currentHash":"6ac3d12","state":1,"snapshotUri":"chat-editing-snapshot-text-model:/home/shiham/.config/snappy-switcher/themes/catppuccin-mocha-dark.ini?%7B%22session%22%3A%7B%22%24mid%22%3A1%2C%22external%22%3A%22vscode-chat-session%3A%2F%2Flocal%2FMTRhOGQ2NDUtMWNiYS00ZGVmLTk4ZDYtNTlhZTAzY2QwYmMz%22%2C%22path%22%3A%22%2FMTRhOGQ2NDUtMWNiYS00ZGVmLTk4ZDYtNTlhZTAzY2QwYmMz%22%2C%22scheme%22%3A%22vscode-chat