/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
    dmenu-display-format:       "{name}";
    icon-theme:                 "hicolor";
}

/*****----- Global Properties -----*****/
@import "~/.config/rofi/colors/colors.rasi"
@import "~/.config/rofi/font/fonts.rasi"

* {
    background-color:           transparent;
    text-color:                 @foreground;
    margin:                     0px;
    padding:                    0px;
    spacing:                    0px;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       900px;
    height:                      500px;
    border:                      2px solid;
    border-radius:               20px;
    border-color:                @background-alt;
    background-color:            @background;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    padding:                     20px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     10px 16px;
    border:                      2px solid;
    border-radius:               12px;
    border-color:                @background-alt;
    background-color:            @background;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    text-color:                  @selected;
}

entry {
    enabled:                     true;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           @background-alt;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       2;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-columns:               true;
    fixed-height:                false;
    spacing:                     15px;
    margin:                      15px 0px 0px 0px;
    border:                      0px solid;
    background-color:            transparent;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     8px;
    border-radius:               12px;
    background-color:            transparent;
    text-color:                  @foreground;
    orientation:                 vertical;
    spacing:                     6px;
    cursor:                      pointer;
}

element selected.normal {
    background-color:            @background-alt;
    text-color:                  @selected;
    border:                      2px solid;
    border-color:                @selected;
}

element-icon {
    size:                        160px;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    expand:                      true;
    cursor:                      inherit;
    background-color:            transparent;
}

element-text {
    text-color:                  inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    expand:                      false;
    cursor:                      inherit;
    background-color:            transparent;
}