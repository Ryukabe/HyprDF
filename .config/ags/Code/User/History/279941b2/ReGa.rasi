/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
    dmenu-display-format:       "{name}";
}

/*****----- Global Properties -----*****/
@import "~/.config/rofi/colors/colors.rasi"
@import "~/.config/rofi/font/fonts.rasi"

* {
    background-color:           transparent;
    text-color:                 @foreground;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       900px;
    height:                      400px;
    border:                      2px solid;
    border-radius:               20px;
    border-color:                @background-alt; /* */
    background-color:            @background;     /* */
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     15px;
    padding:                     25px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     12px 16px;
    border:                      2px solid;
    border-radius:               15px;
    border-color:                @background-alt; /*[cite: 4] */
    background-color:            @background;     /*[cite: 4] */
    text-color:                  @foreground;     /*[cite: 4] */
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    text-color:                  @selected;       /*[cite: 4] */
}

entry {
    enabled:                     true;
    text-color:                  @foreground;     /*[cite: 4] */
    cursor:                      text;
    placeholder:                 "Search wallpapers...";
    placeholder-color:           @background-alt; /*[cite: 4] */
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-columns:               true;
    
    /* These lines fix the separator issue */
    spacing:                     20px;
    margin:                      10px 0px 0px 0px; 
    border:                      0px solid;        
    background-color:            transparent;
}  background-color:            transparent;


/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     15px;
    border-radius:               15px;
    background-color:            transparent;
    text-color:                  @foreground;     /*[cite: 4] */
    orientation:                 vertical;
}

element selected.normal {
    background-color:            @background-alt; /*[cite: 4] */
    text-color:                  @selected;       /*[cite: 4] */
    border:                      2px solid;
    border-color:                @selected;
}

element-icon {
    size:                        160px;
    horizontal-align:            0.5;
    cursor:                      inherit;
    background-color:            transparent;     /* Fix for background issues */
}

element-text {
    text-color:                  inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    cursor:                      inherit;
    background-color:            transparent;
}