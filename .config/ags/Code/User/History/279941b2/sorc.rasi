/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
    dmenu-display-format:       "{name}";
}

/*****----- Global Properties -----*****/
@import "~/.config/rofi/colors/colors.rasi"
@import "~/.config/rofi/font/fonts.rasi"

* {
    background-color:           transparent;
    text-color:                 @foreground;
    margin:                     0px;
    padding:                    0px;
    spacing:                    0px;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    /* Adjusted width and height to fit 4 images tightly */
    width:                       860px; 
    height:                      280px; 
    border:                      2px solid;
    border-radius:               20px;
    border-color:                @background-alt;[cite: 4, 7]
    background-color:            @background;    [cite: 4, 7]
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px; 
    padding:                     20px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     10px 16px;
    border:                      2px solid;
    border-radius:               12px;
    border-color:                @background-alt;[cite: 4, 7]
    background-color:            @background;    [cite: 4, 7]
    text-color:                  @foreground;    [cite: 4, 7]
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    text-color:                  @selected;      [cite: 4, 7]
}

entry {
    enabled:                     true;
    text-color:                  @foreground;    [cite: 4, 7]
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           @background-alt;[cite: 4, 7]
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-columns:               true;
    fixed-height:                true;   
    spacing:                     15px;    /* Gap between image cards */
    margin:                      15px 0px 0px 0px; 
    border:                      0px solid;       
    background-color:            transparent;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     8px;        
    border-radius:               12px;
    background-color:            transparent;
    text-color:                  @foreground;[cite: 4, 7]
    orientation:                 vertical;    [cite: 6, 7]
    spacing:                     0px;        [cite: 7]
}

element selected.normal {
    background-color:            @background-alt;[cite: 4, 7]
    text-color:                  @selected;      [cite: 4, 7]
    border:                      2px solid;
    border-color:                @selected;      [cite: 7]
}

element-icon {
    size:                        140px;       /* Optimized for 280px window height */
    horizontal-align:            0.5;
    vertical-align:              0.5;
    expand:                      false;      [cite: 7]
    cursor:                      inherit;
    background-color:            transparent;
}

element-text {
    text-color:                  inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;         
    expand:                      false;      [cite: 7]
    cursor:                      inherit;
    background-color:            transparent;
}