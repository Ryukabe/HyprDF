configuration {
    show-icons: true;
    icon-theme: "Papirus";
}

@import "colors/colors.rasi" /* Import your existing theme colors[cite: 2] */

window {
    width: 800px;
    height: 400px;
    border: 2px;
    border-radius: 12px;
    background-color: @bg;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 15px;
    padding: 20px;
}

inputbar {
    children: [ "prompt", "entry" ];
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px;
}

listview {
    columns: 4;     /* Shows 4 images side-by-side */
    lines: 1;       /* Keep it to one row for the look in your image */
    layout: vertical;
    fixed-columns: true;
    spacing: 10px;
}

element {
    orientation: vertical; /* Text below the image */
    padding: 10px;
    border-radius: 8px;
}

element-icon {
    size: 150px; /* Adjust to match your screenshot's preview size */
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font 9";
}

element selected {
    background-color: @selected-bg;
    text-color: @selected-fg;
}