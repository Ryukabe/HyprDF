/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
    dmenu-display-format:       "{name}";
}

/*****----- Global Properties -----*****/
@import "~/.config/rofi/colors/colors.rasi"
@import "~/.config/rofi/font/fonts.rasi"

* {
    background-color:           transparent;
    text-color:                 @foreground;
    margin:                     0px;
    padding:                    0px;
    spacing:                    0px;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    /* Reduced height from 400px to 320px to remove extra bottom space[cite: 6, 7] */
    width:                       900px;
    height:                      320px;
    border:                      2px solid;
    border-radius:               20px;
    border-color:                @background-alt;[cite: 4, 7]
    background-color:            @background;    [cite: 4, 7]
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px; /* Removed spacing to kill line/gap[cite: 7] */
    padding:                     25px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     12px 16px;
    border:                      2px solid;
    border-radius:               15px;
    border-color:                @background-alt;[cite: 4, 7]
    background-color:            @background;    [cite: 4, 7]
    text-color:                  @foreground;    [cite: 4, 7]
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @selected;      [cite: 4, 7]
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;    [cite: 4, 7]
    cursor:                      text;
    placeholder:                 "Search wallpapers...";
    placeholder-color:           @background-alt;[cite: 4, 7]
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-columns:               true;
    fixed-height:                true;   [cite: 7]

    spacing:                     20px;
    margin:                      15px 0px 0px 0px; /* Clean gap without dotted line[cite: 7] */
    border:                      0px solid;       [cite: 7]
    background-color:            transparent;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     10px;        
    border-radius:               15px;
    background-color:            transparent;
    text-color:                  @foreground;[cite: 4, 7]
    orientation:                 vertical;   [cite: 3, 7]
    spacing:                     0px;        [cite: 7]
}

element selected.normal {
    /* Set to background-alt for contrast like your minimal.rasi[cite: 4, 7] */
    background-color:            @background-alt; 
    text-color:                  @selected;      [cite: 4, 7]
    border:                      2px solid;
    border-color:                @selected;      [cite: 7]
}

element-icon {
    size:                        150px;      [cite: 7]
    horizontal-align:            0.5;
    vertical-align:              0.5;
    expand:                      false;       /* Prevents stretching[cite: 7] */
    cursor:                      inherit;
    background-color:            transparent;
}

element-text {
    text-color:                  inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;         
    expand:                      false;      [cite: 7]
    margin:                      0px;        [cite: 7]
    cursor:                      inherit;
    background-color:            transparent;
}