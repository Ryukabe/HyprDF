/*--------Global Properties Theming--------*/
@import "~/.config/rofi/colors/colors.rasi"
@import "~/.config/rofi/font/fonts.rasi"

* {
  background-color: transparent;
  text-color:       @foreground;
  padding:          0px;
  margin:           0px;
}

window {
  fullscreen:       true;
  padding:          10px;
  background-color: @background;
  transparency:     "real";
}

mainbox {
  padding:          8px;
}

inputbar {
  background-color: @background-alt;
  margin:           36px calc( 50% - 160px );
  padding:          10px 20px;
  spacing:          10px;
  border:           1px;
  border-radius:    24px;
  border-color:     @background-alt;
  children:         [ icon-search, entry ];
}

prompt {
  enabled: false;
}

icon-search {
  expand:         false;
  filename:       "search";
  vertical-align: 0.5;
}

entry {
  placeholder:        "Search";
  placeholder-color:  @foreground;
}

listview {
  margin:        48px 32px;
  spacing:       32px;
  columns:       6;
  lines:         4;
  fixed-columns: true;
  fixed-height:  false;
  dynamic:       true;
  scrollbar:     false;
}

element, element-text, element-icon {
  cursor: pointer;
}

element {
  padding:        6px;
  spacing:        4px;
  orientation:    vertical;
  border-radius:  18px;
  children:       [ element-icon, element-text ];
}

element selected {
  background-color: @background-alt;
}

element-icon {
  size:             72px;
  horizontal-align: 0.5;
}

element-text {
  horizontal-align: 0.5;
  font:             "SF Pro Text Bold";
}