{
 "layer": "top",
 "position": "top",

 "reload_style_on_change": true,
 "modules-left": ["custom/appdrawer","custom/phone","tray"],
 "modules-center": ["hyprland/workspaces"],
 "modules-right": ["group/expand","pulseaudio","network","clock","tray"],

   "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
        "active": "",
        "default": "",
        "empty": ""
    },
    "persistent-workspaces": { "*": 5 }
    },

    "clock": {
      "timezone": ["ETC/UTC", "Asia/Dhaka"],
      "interval": 60,
      "format": "{:%I:%M %p}",
      "max-length": 25,
      "tooltip": true
    },

    "custom/appdrawer": {
        "format" : "󰣇",
        "tooltip": false,
        "tooltip-format": "App Drawer",
        "on-click": "pkill rofi || rofi -show drun -theme /home/shiham/.config/rofi/launchpad.rasi -name appdrawer"
    },

    "custom/powermenu": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/wlogout/scripts/wlogout.sh",
        "tooltip-format": "Open Power Menu"
    },

    "custom/phone": {
     "format": "{icon} {text}",
     "format-icons": {
      "connected": "",
      "disconnected": "" 
    },
     "return-type": "json",
     "exec": "~/.config/waybar/scripts/phone_status.py", 
     "on-click": "kdeconnect",
     "interval": 60,
     "tooltip": false
    },

    "network": {
       "interface": "wlan0",
       "format": "{ifname}",
       //"format-wifi": "{icon} {essid}",
       "format-wifi": "{icon}",
        "format-icons": [
          "󰤯", //0
          "󰤟", //25
          "󰤢", //50
          "󰤥", //75
          "󰤨"  //100
        ],
       "format-ethernet": "{ipaddr}/{cidr} 󰊗",
       "format-disconnected": "󰤮", //An empty format will hide the module.
       "tooltip-format": "{ifname} via {gwaddr} 󰊗",
       "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
       "tooltip-format-ethernet": "{ifname} ",
       "tooltip-format-disconnected": "Disconnected",
       "max-length": 50
     },
    
   "pulseaudio": {
    //"format": "{icon} {volume}%",
    "format": "{icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-muted": "Muted 󰝟",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": [
        "",   // 0-20
        "",  // 21-50
        "󰕾",  // 51-70
        ""  // 71-100
      ]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": [
      "Easy Effects Sink"
    ]
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "custom/expand": {
        "format": "",
        "tooltip": false
    },
    "custom/endpoint":{
        "format": "|",
        "tooltip": false
    },
    "group/expand": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "transition-to-left": true
        //    "click-to-reveal": true
        },
        "modules": ["custom/expand,"pulseaudio/slider"]
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    }
}   

