{
  "layer": "top",
  "position": "top",
  "include": ["~/.config/waybar/modules/*.jsonc"],

  "modules-left": [
    "custom/applauncher", 
    "custom/phone",
    "custom/media"
  ],

  "modules-center": [
    "clock",
    "hyprland/workspaces"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "custom/notification"
  ],
  






  //Custom application launcher 
  "custom/applauncher": {
    "format" : "󰣇",
    "tooltip": false,
    "tooltip-format": "App launcher",
    "on-click": "pkill rofi || rofi -show drun -theme ~/.config/rofi/launchpad.rasi"
  },

  //Custom media player module 
  "custom/media": {
    "format": "{icon} {text}",
    "escape": true,
    "return-type": "json",
    "max-length": 20,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "smooth-scrolling-threshold": 10, // This value was tested using a trackpad, it should be lowered if using a mouse.
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "~/.config/waybar/scripts/mediaplayer.py", // Script in resources/custom_modules folder
    "format-icons": {
      "spotify": "",
      "zen-browesr": "",
      "mpv": "",
      "vlc": "󰕼"
      //S"default": ""
    }
  },

  // SwayNC notification module
  "custom/notification": {
    "tooltip": true,
    "format": "{0} {icon}",
    //"format": "<span size='16pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  //Custom phone status module
 "custom/phone": {
    "format": "{icon} {text}",
    "format-icons": {
      "connected": "",
      "disconnected": "" 
    },
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/phone_status.py", 
    "on-click": "kdeconnect",
    "interval": 60,
    "tooltip": false
 }
}