{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "include": ["~/.config/waybar/modules/*.jsonc"],

  "modules-left": [
    "group/menu",
    "hyprland/workspaces"
  ],
/*"custom/phone",
#"custom/media",*/
  "modules-center": [
    "clock"
  ],

  "modules-right": [
   
    "group/volume",
    "network",
    "custom/notification"
  ],

"group/menu": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 1000,
      "transition-right-to-left": true
    },
    "modules": [
      "custom/appdrawer", 
      "custom/powermenu"
    ]
  },

 "group/volume": {
   "orientation": "horizontal",
   "drawer": {
       "transition-duration": 1000,
       "transition-left-to-right": false,
       "children-class": "not-pulesaudio",
       "click-to-reveal": true
   },
   "modules" : [
       "pulseaudio", "pulseaudio/slider"
   ]
  }
}